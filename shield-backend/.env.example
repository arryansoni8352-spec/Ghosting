# GHOSTING AI Shield backend configuration. Copy to .env. Every variable is optional.
# Never commit .env, API keys, or model weights.

# ---- access & abuse control ------------------------------------------------------------------
# disabled = development only (refuses to start in production mode)
# open     = no access key; per-job tokens + rate limits still apply
# api_key  = users must enter an access key (SHA-256 digests below); the key is never in website JS
SHIELD_AUTH_MODE=disabled
SHIELD_API_KEY_SHA256=              # comma-separated sha256 hex digests, e.g. $(printf 'my-key' | sha256sum)
SHIELD_PRODUCTION_MODE=false        # true: refuses auth_mode=disabled and refuses unconfirmed-licence weights
SHIELD_RATE_LIMIT_PER_MINUTE=30     # uploads per client address
SHIELD_READ_RATE_LIMIT_PER_MINUTE=600   # status polling / downloads per client address
SHIELD_CORS_ORIGINS=                # e.g. https://ghosting.site  (empty = no CORS = browsers blocked)
SHIELD_FORWARDED_ALLOW_IPS=         # Reverse-proxy IP or CIDR (e.g. 10.0.0.1 or 172.16.0.0/12). Leave empty
                                    # for direct exposure. NEVER set to *.

# ---- model weights (licence for MobileNetV1 checkpoint is UNRESOLVED) -------------------------
SHIELD_ALLOW_WEIGHT_DOWNLOAD=false  # only an operator should ever turn this on

# ---- compute & jobs (single worker deployment) ------------------------------------------------
SHIELD_DEVICE=cpu                   # auto | cpu | gpu
SHIELD_MAX_CONCURRENT_JOBS=1
SHIELD_MAX_QUEUED_JOBS=4
SHIELD_JOB_TIMEOUT_SECONDS=1800
SHIELD_JOB_TTL_SECONDS=3600         # how long finished results are kept before automatic deletion
SHIELD_JOB_DIR=/data/jobs
SHIELD_LOG_LEVEL=INFO

# ---- image limits -------------------------------------------------------------------------------
SHIELD_IMAGE_INPUT_POLICY=lossless_only   # lossless_only | any (legacy)
SHIELD_MAX_UPLOAD_MB=15
SHIELD_MAX_INPUT_PIXELS=262144

# ---- video limits (experimental) ----------------------------------------------------------------
SHIELD_VIDEO_ENABLED=true
SHIELD_VIDEO_MAX_UPLOAD_MB=50
SHIELD_VIDEO_MAX_DURATION_S=10
SHIELD_VIDEO_MAX_PIXELS=262144
SHIELD_VIDEO_MAX_FPS=30
SHIELD_VIDEO_MAX_FRAMES=300
SHIELD_VIDEO_MAX_KEYFRAMES=4
SHIELD_VIDEO_MAX_TEMP_MB=1024
SHIELD_VIDEO_FFMPEG_TIMEOUT_S=300
SHIELD_FFMPEG_PATH=ffmpeg
SHIELD_FFPROBE_PATH=ffprobe
