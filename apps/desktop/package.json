{
  "name": "veilguard-desktop",
  "version": "0.1.0-rc1",
  "private": true,
  "description": "VeilGuard desktop application",
  "author": "VeilGuard Research Team",
  "main": "dist-electron/apps/desktop/electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src electron --ext .ts,.tsx",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "electron-store": "10.0.1",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.2",
    "@types/uuid": "10.0.0",
    "@vitejs/plugin-react": "4.5.1",
    "@vitest/coverage-v8": "3.2.3",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "electron": "35.7.5",
    "electron-builder": "25.1.8",
    "eslint": "8.57.1",
    "happy-dom": "17.5.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "5.7.3",
    "vite": "6.3.5",
    "vitest": "3.2.3",
    "wait-on": "8.0.3"
  },
  "build": {
    "appId": "com.veilguard.desktop",
    "productName": "VeilGuard",
    "electronVersion": "35.7.5",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../engine",
        "to": "engine",
        "filter": [
          "**/*",
          "!.venv/**",
          "!__pycache__/**",
          "!*.pyc"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    }
  }
}
